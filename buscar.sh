#!/bin/bash
# Busca una palabra en una carpeta
# Uso: bash nombre_del_programa palabra [carpeta]

if [ $# -lt 1 ]; then
    echo "Uso: bash $0 palabra [carpeta]"
    exit 1
fi

PALABRA="$1"
CARPETA="${2:-.}"

if [ ! -d "$CARPETA" ]; then
    echo "Error: la carpeta $CARPETA no existe"
    exit 1
fi

grep -rIlF -- "$PALABRA" "$CARPETA" 2>/dev/null
