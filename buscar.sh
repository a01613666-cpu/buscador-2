#!/bin/bash
# Busca una palabra en los archivos de una carpeta
# Uso: bash nombre_del_programa palabra [carpeta]
# Sin carpeta, busca en todo el sistema de almacenamiento

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "Uso: bash $0 palabra [carpeta]"
    echo "Se permiten maximo dos argumentos"
    exit 1
fi

PALABRA="$1"

if [ -n "$2" ]; then
    if [ ! -d "$2" ]; then
        echo "Error: la carpeta $2 no existe"
        exit 1
    fi
    RUTAS=("$2")
else
    echo "Sin carpeta: buscando en todo el sistema (puede tardar)..."
    case "$(uname -s)" in
        MINGW*|MSYS*) RUTAS=(/[a-z]) ;;
        *) RUTAS=(/) ;;
    esac
fi

RESULTADOS=$(grep -rIlF -- "$PALABRA" "${RUTAS[@]}" 2>/dev/null)

if [ -z "$RESULTADOS" ]; then
    echo "No se encontro la palabra '$PALABRA'"
else
    echo "$RESULTADOS"
fi
EOF 


