#!/bin/bash
# Busca una palabra o frase en una carpeta y cuenta cuantas veces aparece
# Uso: bash nombre_del_programa "palabra o frase" carpeta

if [ $# -ne 2 ]; then
    echo "Uso: bash $0 \"palabra o frase\" carpeta"
    echo "Se necesitan exactamente dos argumentos"
    exit 1
fi

PALABRA="$1"
CARPETA="$2"

if [ ! -d "$CARPETA" ]; then
    echo "Error: la carpeta $CARPETA no existe"
    exit 1
fi

ENCONTRADO=0

while IFS= read -r ARCHIVO_ENC; do
    VECES=$(grep -oF -- "$PALABRA" "$ARCHIVO_ENC" | wc -l | tr -d ' ')
    echo "$ARCHIVO_ENC: $VECES veces"
    ENCONTRADO=1
done < <(grep -rIlF --exclude-dir=.git -- "$PALABRA" "$CARPETA" 2>/dev/null)

if [ $ENCONTRADO -eq 0 ]; then
    echo "No se encontro '$PALABRA' en $CARPETA"
fi
